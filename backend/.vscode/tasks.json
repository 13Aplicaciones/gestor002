    "version": "2.0.0",
    "tasks": [
        {
            "label": "full-spring",
            "type": "shell",
            "command": "mvn clean install  -Dmaven.test.skip=true spring-boot:run",  
            "group": {
                "kind": "build",
                "isDefault": true
